{
  "expo": {
    "name": "BibiMarcos",
    "slug": "bibimarcos-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysPermission": "O BibiMarcos precisa de acesso à localização para conectar motoristas e passageiros mesmo em segundo plano.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#064e3b",
          "androidMode": "default",
          "androidCollapsedTitle": "BibiMarcos"
        }
      ],
      "expo-image-picker",
      "expo-task-manager",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "./plugins/withAndroidForegroundService",
        {
          "foregroundServiceType": "location"
        }
      ],
      "expo-asset"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#10b981"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.bibimarcos.bibimarcosapp",
      "permissions": [
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "http://p12v8ns66xyrez0h1ywnhj8w.72.61.43.154.sslip.io",
      "wsUrl": "ws://p12v8ns66xyrez0h1ywnhj8w.72.61.43.154.sslip.io/ws",
      "eas": {
        "projectId": "487c115e-cec4-4098-a64f-e63c74599a72"
      }
    }
  }
}
