{
  "expo": {
    "name": "BibiMarcos",
    "slug": "bibimarcos-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysPermission": "O BibiMarcos precisa de acesso à localização para conectar motoristas e passageiros mesmo em segundo plano.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#064e3b",
          "androidMode": "default",
          "androidCollapsedTitle": "BibiMarcos",
          "useNextNotificationsApi": true
        }
      ],
      "expo-image-picker",
      "expo-task-manager",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "./plugins/withAndroidForegroundService",
        {
          "foregroundServiceType": "location"
        }
      ],
      "./plugins/withCleartextTraffic",
      "expo-asset",
      "expo-secure-store"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#10b981"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.bibimarcos.bibimarcosapp",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.USE_FULL_SCREEN_INTENT"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "http://p12v8ns66xyrez0h1ywnhj8w.72.61.43.154.sslip.io",
      "wsUrl": "ws://p12v8ns66xyrez0h1ywnhj8w.72.61.43.154.sslip.io/ws",
      "eas": {
        "projectId": "98b23ec1-605b-4112-b30c-d14046bb9e50"
      }
    },
    "owner": "bibimarcos2"
  }
}
